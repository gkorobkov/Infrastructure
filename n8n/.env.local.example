# Local Windows 11 or macOS User deployment; separate from the server's .env.
N8N_PROJECT_NAME=n8n-cmpsprj
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_VERSION=2.47.7
N8N_DATA_PATH=./VLM_DATA
N8N_TIMEZONE=Europe/Moscow
N8N_OPEN_BROWSER=true
N8N_DOCKER_CONTEXT=desktop-linux
N8N_DOCKER_TIMEOUT_SECONDS=600
N8N_STARTUP_TIMEOUT_SECONDS=240
N8N_MIN_WINDOWS_BUILD=22631
# Filled automatically on first launch and preserved on subsequent launches.
N8N_ENCRYPTION_KEY=GENERATE_ON_FIRST_RUN
N8N_RUNNERS_AUTH_TOKEN=GENERATE_ON_FIRST_RUN
N8N_DOCKER_INSTALLER_URL_AMD64=https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe
N8N_DOCKER_INSTALLER_URL_ARM64=https://desktop.docker.com/win/main/arm64/Docker%20Desktop%20Installer.exe
